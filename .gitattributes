# Normalise line endings. The team is cross-platform and .editorconfig asks for LF;
# without this, Windows checkouts commit CRLF and every file churns on macOS/Linux.
* text=auto eol=lf

# Binary - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary

# Shell scripts must stay LF even on Windows checkouts (they run in the container).
*.sh text eol=lf
Dockerfile text eol=lf
